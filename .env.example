# Postgres
POSTGRES_USER=loang
POSTGRES_PASSWORD=loang
POSTGRES_DB=loang
DATABASE_URL=postgresql://loang:loang@localhost:5432/loang

# Anthropic
# Introduce aquí tu clave de API de Anthropic (https://console.anthropic.com/keys)
ANTHROPIC_API_KEY=

# Token budget per agent run; circuit breaker honours this.
CIRCUIT_BREAKER_MAX_TOKENS=4000

# Minimum confidence to auto-resolve an incident (0.0–1.0)
CONFIDENCE_THRESHOLD=0.75

# Encryption at rest for credentials stored in the customer table (Fernet, 44-char base64).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TODO loang-template: rotate this before deploying to production
FERNET_KEY=

# Sentry (deferred to v0.2.0; left here so the env contract is complete)
SENTRY_DSN_BACKEND=
SENTRY_DSN_DASHBOARD=

# NextAuth
# TODO loang-template: set NEXTAUTH_SECRET to a random 32+ char string and configure provider
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Logging
LOG_LEVEL=INFO

# Agent API URL used by the dashboard to call the FastAPI backend
AGENT_API_URL=http://localhost:8000
