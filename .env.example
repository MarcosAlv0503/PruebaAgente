# Postgres
POSTGRES_USER=loang
POSTGRES_PASSWORD=loang
POSTGRES_DB=loang
DATABASE_URL=postgresql://loang:loang@localhost:5432/loang

# OpenRouter
# TODO loang-template: get an API key at https://openrouter.ai/keys and paste here
OPENROUTER_API_KEY=

# Token budget per agent run; OpenRouterClient circuit breaker honours this.
MAX_TOKENS_PER_RUN=1000000

# Encryption at rest for credentials stored in the customer table (Fernet, 44-char base64).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TODO loang-template: rotate this before deploying to production
FERNET_KEY=

# Sentry (deferred to v0.2.0; left here so the env contract is complete)
SENTRY_DSN_BACKEND=
SENTRY_DSN_DASHBOARD=

# NextAuth
# TODO loang-template: set NEXTAUTH_SECRET to a random 32+ char string and configure provider
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Logging
LOG_LEVEL=INFO

# Agent API URL used by the dashboard to call the FastAPI backend
AGENT_API_URL=http://localhost:8000

# GitHub PAT used by `docker compose build` (BuildKit secret) and by CI to
# fetch `loang-toolkit` from its private repo. Locally you can reuse the
# token from `gh auth token`; CI uses a service-account PAT stored as the
# repo secret `LOANG_TOOLKIT_TOKEN`.
LOANG_TOOLKIT_TOKEN=
